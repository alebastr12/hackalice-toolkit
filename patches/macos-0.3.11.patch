diff --git a/alisa_cli/mac_browser.py b/alisa_cli/mac_browser.py
new file mode 100644
index 0000000..8cfc081
--- /dev/null
+++ b/alisa_cli/mac_browser.py
@@ -0,0 +1,122 @@
+"""macOS sign-in window and dedicated-profile process control.
+
+Chrome, Edge and Chromium keep one profile per user-data directory. The
+profile lock is not portable enough here, so the owning process is found by
+its exact ``--user-data-dir`` argument in ``ps``. Helper processes carry
+``--type=`` and are never treated as the window owner.
+"""
+import os,re,shutil,signal,subprocess,time
+from pathlib import Path
+
+APPLICATIONS = (
+    ('Google Chrome', 'Google Chrome'),
+    ('Microsoft Edge', 'Microsoft Edge'),
+    ('Chromium', 'Chromium'),
+)
+BUNDLE_NAMES = ('Google Chrome', 'Microsoft Edge', 'Chromium', 'chrome', 'chromium', 'msedge')
+
+
+def browser():
+    """Return the first usable Chromium-based browser executable."""
+    override = os.environ.get('ALISA_BROWSER')
+    candidates = [Path(override).expanduser()] if override else []
+    for bundle, binary in APPLICATIONS:
+        suffix = Path(bundle + '.app/Contents/MacOS/' + binary)
+        candidates += [Path('/Applications')/suffix, Path.home()/'Applications'/suffix]
+    for name in ('chromium', 'google-chrome', 'google-chrome-stable', 'microsoft-edge', 'chrome'):
+        found = shutil.which(name)
+        if found:
+            candidates.append(Path(found))
+    return next((path for path in candidates if path.is_file() and os.access(path, os.X_OK)), None)
+
+
+def _browser_executable(command):
+    executable = command.split(' --', 1)[0]
+    name = Path(executable).name
+    return name in BUNDLE_NAMES or any(part in executable for part in ('Google Chrome', 'Chromium', 'Microsoft Edge'))
+
+
+def profile_pid(profile):
+    """PID of the browser window that owns exactly this profile, or None."""
+    profile = Path(profile).resolve()
+    marker = '--user-data-dir=' + str(profile)
+    try:
+        output = subprocess.run(['ps', '-axo', 'pid=,command='], capture_output=True, timeout=10).stdout
+    except (OSError, subprocess.SubprocessError):
+        return None
+    for line in output.decode(errors='replace').splitlines():
+        line = line.strip()
+        if not line:
+            continue
+        pid_text, _, command = line.partition(' ')
+        command = command.strip()
+        if not pid_text.isdecimal() or '--type=' in command:
+            continue
+        if not re.search(r'(?:^|\s)' + re.escape(marker) + r'(?=\s|$)', command):
+            continue
+        if _browser_executable(command):
+            return int(pid_text)
+    return None
+
+
+def page_ready(profile):
+    """Best-effort title check; native sign-in does not depend on it."""
+    pid = profile_pid(profile)
+    if pid is None:
+        return False
+    script = ('tell application "System Events" to get name of every window of '
+              '(first process whose unix id is %d)' % pid)
+    try:
+        result = subprocess.run(['osascript', '-e', script], capture_output=True, timeout=5)
+    except (OSError, subprocess.SubprocessError):
+        return False
+    if result.returncode:
+        return False
+    from .login_browser import login_title_ready
+    return any(login_title_ready(title) for title in result.stdout.decode(errors='replace').split(', '))
+
+
+def open_window(profile, proxy=None):
+    profile = Path(profile).resolve()
+    existing = profile_pid(profile)
+    if existing is not None:
+        return existing
+    executable = browser()
+    if executable is None:
+        raise RuntimeError('Установите Google Chrome, Microsoft Edge или Chromium: brew install --cask google-chrome')
+    profile.mkdir(parents=True, exist_ok=True, mode=0o700)
+    profile.chmod(0o700)
+    args = [str(executable), '--user-data-dir=' + str(profile), '--no-first-run',
+            '--no-default-browser-check', '--disable-background-mode', '--disable-extensions',
+            '--disable-sync', '--new-window']
+    if proxy:
+        args.append('--proxy-server=' + proxy)
+    process = subprocess.Popen(args + ['https://chatgpt.com/auth/login'], stdin=subprocess.DEVNULL,
+                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    time.sleep(.3)
+    if process.poll() is not None and profile_pid(profile) is None:
+        raise RuntimeError('Окно входа не открылось. Проверьте, не занят ли отдельный профиль браузера.')
+    return process.pid
+
+
+def close_profile(profile):
+    pid = profile_pid(profile)
+    if pid is None:
+        return
+    try:
+        os.kill(pid, signal.SIGTERM)
+    except ProcessLookupError:
+        return
+    for _ in range(80):
+        if profile_pid(profile) is None:
+            return
+        time.sleep(.1)
+    try:
+        os.kill(pid, signal.SIGKILL)
+    except ProcessLookupError:
+        return
+    for _ in range(40):
+        if profile_pid(profile) is None:
+            return
+        time.sleep(.1)
+    raise RuntimeError('Окно входа ещё закрывается. Дождитесь его закрытия и повторите вход; профиль сохранён.')
